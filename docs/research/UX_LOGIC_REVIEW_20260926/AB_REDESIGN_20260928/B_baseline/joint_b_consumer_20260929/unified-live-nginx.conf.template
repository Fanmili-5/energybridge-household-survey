# Add within the existing HTTPS server. The engineering page is public;
# the server still checks its session, origin and CSRF token on writes.
location = /joint-b {
    auth_basic off;
    client_max_body_size 2m;
    limit_req zone=eb_general burst=60 nodelay;
    proxy_pass http://127.0.0.1:18770;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 30s;
}
location ^~ /joint-b/ {
    auth_basic off;
    client_max_body_size 2m;
    limit_req zone=eb_general burst=60 nodelay;
    proxy_pass http://127.0.0.1:18770;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 30s;
}
