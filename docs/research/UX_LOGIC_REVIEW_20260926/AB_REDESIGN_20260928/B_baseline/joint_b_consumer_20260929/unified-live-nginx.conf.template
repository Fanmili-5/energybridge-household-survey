# Add within the existing HTTPS server. The route exposes synthetic household
# and scenario data, so do not remove auth_basic for engineering trials.
location = /joint-b {
    auth_basic "EnergyBridge engineering trial";
    auth_basic_user_file /etc/nginx/eb-demo.htpasswd;
    client_max_body_size 2m;
    limit_req zone=eb_general burst=60 nodelay;
    proxy_pass http://127.0.0.1:18770;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 30s;
}
location ^~ /joint-b/ {
    auth_basic "EnergyBridge engineering trial";
    auth_basic_user_file /etc/nginx/eb-demo.htpasswd;
    client_max_body_size 2m;
    limit_req zone=eb_general burst=60 nodelay;
    proxy_pass http://127.0.0.1:18770;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 30s;
}
