{"exact_times_and_quantities":"declared_input_scenarios;not_population_estimates_or_direct_paper_parameter_transfer","rules":[{"classification":"declared_input_and_source_supported_model_structure","id":"LIFE-01","implementation":"life.py:build_days","parameters":["member_calendars"],"rule":"完整人员日历与活动位置先于设备计划；未知职业和偏好不推断","sources":["Chen2022StochasticStock"]},{"classification":"project_service_condition","id":"LIFE-02","implementation":"life.py:generate_household","parameters":["daily_quantity_kg","capacity_kg","daily_service","initial_inventory_kg"],"rule":"按给定衣物进入量、容量和每日服务条件形成库存与批次","sources":["legacy_A46"]},{"classification":"source_supported_structure_and_project_mapping","id":"LIFE-03","implementation":"life.py:generate_household","parameters":["deadline_after_release_min","preferred_start_min"],"rule":"餐具需求从实际声明的晚餐结束与参与者形成；不直接填机器启动时间","sources":["Chen2022StochasticStock"]},{"classification":"project_deterministic_scheduler","id":"LIFE-04","implementation":"life.py:Scheduler.program","parameters":["step_min","operation_duration_min","seed","start_deviation_weight","preload_wait_weight","retrieval_wait_weight","machine_windows_min","maximum_preload_wait_min","maximum_retrieval_wait_min","timer_allowed"],"rule":"完整装载—非中断程序—取出在原人员、空间和整段占用内排程","sources":["legacy_A46"]},{"classification":"physical_precedence_and_project_resource_rule","id":"LIFE-05","implementation":"life.py:generate_household;model.py:program_issues","parameters":["upstream_service_id","duration_min"],"rule":"独立烘干机只接收已真实取出的湿衣，必须保留装入与取出","sources":["Chen2022StochasticStock"]},{"classification":"declared_habit_not_measured_preference","id":"LIFE-06","implementation":"life.py:thermostat_controls","parameters":["mode","hold_min","heating_setpoint_C","cooling_setpoint_C","setback_heating_C","setback_cooling_C","temperature_band_C"],"rule":"实际房间占用与连续/短离保持的控制习惯分开；温度需求另存","sources":["legacy_AC84"]},{"classification":"declared_service_and_controller_parameters","id":"LIFE-07","implementation":"life.py:generate_household","parameters":["hot_water_liters","hot_water_minimum_C","tank_policy"],"rule":"实际洗浴时刻及给定热水数量形成服务；水箱设定与最低出水要求分别记录","sources":["Chen2022StochasticStock"]},{"classification":"physical_connection_and_energy_conservation","id":"LIFE-08","implementation":"life.py:mobility","parameters":["journey_templates","anchor_state","charger_kw","efficiency","capacity_kwh","target_soc","minimum_soc"],"rule":"原出行与插拔形成连接；锚点已连接状态不制造到访；按效率与SOC目标连续记账","sources":["legacy_A46"]},{"classification":"project_failure_policy","id":"LIFE-09","implementation":"life_pipeline.py:build_life;life_physics.py:assemble_life","parameters":[],"rule":"不满足的需求保留且阻止物理准入，不添加帮手、替换日程或丢弃需求","sources":[]},{"classification":"experimental_information_separation","id":"LIFE-10","implementation":"life.py:generate_household;life_physics.py:reference_life","parameters":[],"rule":"A构造不读取事件、电价、B后果或人类答案；这些只在A冻结后接入","sources":[]},{"classification":"project_reference_physics_profile","id":"LIFE-11","implementation":"life_physics.py:baseline_pair","parameters":["decision_min","horizon_min","history_days","tail_days"],"rule":"公开集成使用08:00通知、10分钟网格、显式前史与尾期；不推断真实调度频率","sources":["housing_simulation"]}],"scheduler_defaults":{"operation_duration_min":10,"preload_wait_weight":0.4,"retrieval_wait_weight":0.5,"seed":20261019,"start_deviation_weight":1.0,"step_min":10},"schema":"eb.life_to_A.rule_registry.v1"}
