  "composition": "owned shared assets and declarations > EB household soft habits + scoped member profiles; experimental joint assignment, no A/B labels or random parameter assembly",
  "habit_meaning": "declared benchmark role-play habit,not statistically inferred or measured human habit",
  "household_assignment_origin": "experimental_joint_scenario_design;not_empirically_inferred",
  "household_inheritance_implementation": "household_preferences.py",
  "household_preference_sources": "EB_HOUSEHOLD_PREFERENCE_SOURCES.json",
  "numeric_policy": "Existing declared service/control bounds only. Missing tank/heating adjustment bounds stay unknown and require confirmation. No empirical individual preference claimed.",
  "retired_v2_rule_catalog": {
    "AUTH_NEW_HELP": {
      "condition": "extra handling or changed person/routine",
      "origin": "experimental_setting",
      "purpose": "不将家人空闲当作换人、增加操作或额外预约的授权"
    },
    "AUTH_SCOPE": {
      "condition": "EB device flags + explicit existing consent + device action set",
      "origin": "experimental_setting",
      "purpose": "逐设备/逐动作的授权范围，控制能力与授权分开"
    },
    "H_AFTER_MEAL_DISHES": {
      "condition": "dishwasher owned",
      "origin": "experimental_setting",
      "purpose": "餐后作为一批家务处理，优先方便取出而非临时手洗补救"
    },
    "H_EV_TARGET": {
      "condition": "EV owned and existing journeys",
      "origin": "experimental_setting",
      "purpose": "连接后按原目标备电，不以低于原目标替代成功"
    },
    "H_LAUNDRY_LINKED": {
      "condition": "owned washer+dryer",
      "origin": "experimental_setting",
      "purpose": "洗烘作为一项家务协调，避免只优化洗衣却增加取放负担"
    },
    "H_WASHER_RETRIEVAL": {
      "condition": "washer without dryer",
      "origin": "experimental_setting",
      "purpose": "洗后仍需取出处理，偏好结束时间与本人可操作时间衔接"
    },
    "H_WATER_PREPARE": {
      "condition": "water heater owned",
      "origin": "experimental_setting",
      "purpose": "按既定用水准备热水，不通过等待或挪洗浴换取节省"
    },
    "P_CARE_HANDLING": {
      "condition": "explicit care in resident calendars",
      "origin": "experimental_setting",
      "purpose": "少临时召回照护者，优先减少额外干预"
    },
    "P_CARE_WATER": {
      "condition": "explicit care and bathing calendars",
      "origin": "experimental_setting",
      "purpose": "倾向提前准备照护所需热水，降低临时补救负担"
    },
    "P_MULTIPLE_WINDOWS": {
      "condition": "multiple existing handling opportunities, no declared care",
      "origin": "experimental_setting",
      "purpose": "倾向在原有机会中择时，非固定某个A启动时间"
    },
    "P_NO_KNOWN_WINDOWS": {
      "condition": "no declared handling opportunity",
      "origin": "experimental_setting",
      "purpose": "不声称可随意移动，须先约定操作安排"
    },
    "P_ROOM_REST": {
      "condition": "room explicitly used for child rest AND declared care",
      "origin": "experimental_setting",
      "purpose": "对该房间反复停开更谨慎，不推断疾病或新的温度需求"
    },
    "P_ROOM_USE": {
      "condition": "occupied work/rest room",
      "origin": "experimental_setting",
      "purpose": "保护原房间工作/休息，以小幅调温优于临时停开"
    }
  },
