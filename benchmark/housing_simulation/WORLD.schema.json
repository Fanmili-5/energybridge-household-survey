{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fanmili-5/energybridge-household-survey/benchmark/housing_simulation/WORLD.schema.json",
  "title": "Housing world assembly input v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "eb.housing_world.input.v1"
    },
    "weather_source": {
      "type": "object"
    },
    "settings": {
      "type": "object",
      "properties": {
        "history_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 350
        },
        "tail_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "reference_ach": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        },
        "portal_flow_scale": {
          "enum": [
            0.5,
            1,
            2
          ]
        }
      },
      "required": [
        "history_days",
        "tail_days",
        "reference_ach",
        "portal_flow_scale"
      ],
      "additionalProperties": false
    },
    "thermal_fractions": {
      "type": "object",
      "properties": {
        "washer": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "dryer": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "dishwasher": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "misc": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "refrigerator": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        },
        "cooking": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "washer",
        "dryer",
        "dishwasher",
        "misc",
        "refrigerator",
        "cooking"
      ],
      "additionalProperties": false
    },
    "households": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/household"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "weather_source",
    "settings",
    "thermal_fractions",
    "households"
  ],
  "additionalProperties": false,
  "$defs": {
