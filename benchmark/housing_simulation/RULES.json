        },
        {
          "source_id": "tmyx_provider",
          "role": "provider_method",
          "supports": "提供方对TMYx生成方法及资料时期的说明；不证明住宅站点代表性或5km项目阈值。"
        },
        {
          "source_id": "energyplus24_epw",
          "role": "format_only",
          "supports": "LOCATION、时刻及干球字段约定；全年小时准入和5km阈值为项目规则。"
        }
      ]
    },
    {
      "id": "GEO-01",
      "classification": "project_geometry_rule",
      "rule": "明确矩形公寓语法、层高与中间层边界；求根满足本户分配面积，共享面积守恒。",
      "sources": [],
      "implementation": "kernel/geometry.py:sized",
      "documentation": "METHOD.md#4-面积约束与参考外壳",
      "source_relations": []
    },
    {
      "id": "ASM-01",
      "classification": "project_contract",
      "rule": "完整物理住户名册及每成员唯一床位；每组一个本户独占卧室；不推断共享住户人数。",
      "sources": [],
      "implementation": "assembly.py:bind_world",
      "documentation": "METHOD.md#5-家庭世界自动装配",
      "source_relations": []
    },
    {
      "id": "ASM-02",
      "classification": "published_clearance_method_with_project_MILP_formulation",
      "rule": "显式安装包络、0.1m网格、旋转和通行带联合MILP；穷举合法睡眠房间分配；区分网格无解与求解未完成。",
      "sources": [
        "merrell2011_clearance",
        "scipy_milp"
      ],
      "implementation": "installation.py:place",
      "documentation": "METHOD.md#5-家庭世界自动装配",
