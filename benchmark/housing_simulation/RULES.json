      "source_relations": [
        {
          "source_id": "dest_library",
          "role": "primary_data_catalog",
          "supports": "提供DeST典型建筑原件及目录；材料参数须由已登记原件实际外键提取，不提供总体权重。"
        },
        {
          "source_id": "an2023_prototypes",
          "role": "background_only",
          "supports": "气候、建筑类型与标准年代的典型原型框架背景；不证明本模块几何及参数替换规则。"
        }
      ]
    },
    {
      "id": "REF-02",
      "classification": "project_selection_rule",
      "rule": "同省市、准入与建筑类型优先序过滤后，最小年代区间距离；指定优先项和SHA-256确定并列。",
