      "implementation": "kernel/thermal_environment.py:add_environment",
      "documentation": "METHOD.md#6-家庭物理模型与成对编译",
      "source_relations": [
        {
          "source_id": "ep_mass_conservation",
          "role": "mechanism",
          "supports": "分区质量流量平衡及渗透补风机制；不确定门户系数、0.35ACH或门开启行为。"
        },
        {
          "source_id": "pnnl_bath_exhaust",
          "role": "reference_capacity",
          "supports": "采用间歇浴室50cfm参照；不声称中国法规符合性、住宅设施普及率或20min延时依据。"
        },
        {
          "source_id": "pnnl_kitchen_exhaust",
          "role": "reference_capacity",
          "supports": "100cfm间歇厨房排风参照"
