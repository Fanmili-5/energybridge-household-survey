        {
          "source_id": "nrel_house_simulation_2010",
          "role": "reference_capacity",
          "supports": "100cfm干衣排风与0.5W/cfm背景风机"
        }
      ]
    },
    {
      "id": "PAIR-01",
      "classification": "project_experimental_control",
      "rule": "A/B共用物理世界、天气和前史；通知时点480min，区间外恢复A；前史与至少7天恢复必须完整。B请求只作用于目标家庭获授权资产及其自身操作。",
      "sources": [],
