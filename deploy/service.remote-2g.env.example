# Burst-tolerant profile for a 2 vCPU / 2 GiB web node whose EB + EnergyPlus
# execution is delegated to the private compute service.  No secret belongs in
# this file; keep model and compute credentials in root-owned external files.
EB_PUBLIC_ORIGIN=https://survey.example.org
EB_HUMAN_PILOT=1
EB_PLANNING_ENABLED=0
EB_DATA_DIR=/var/lib/energybridge/jobs
EPLUS_ROOT=/opt/EnergyPlus-24-1-0
EB_PILOT_ENV_FILE=/etc/energybridge/model.env
EB_RESOURCE_DIR=/var/lib/energybridge/limits
EB_WORKERS=16
EB_JOB_TIMEOUT=1200
EB_MAX_PENDING=128
EB_MAX_SESSION_JOBS=2
EB_MAX_DAILY_JOBS=250
EB_MAX_QUEUE_WAIT=2400
EB_ESTIMATED_JOB_SECONDS=300
EB_ADMIN_USER=

# Enable these only after the loopback tunnel and release hash check pass.
# EB_COMPUTE_URL=http://127.0.0.1:18768
# EB_COMPUTE_TOKEN_FILE=/etc/energybridge/compute.token
# EB_REMOTE_TIMEOUT=1320
