[Unit]
Description=EnergyBridge household survey
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=energybridge
Group=energybridge
WorkingDirectory=/opt/energybridge/realtime_pilot
EnvironmentFile=/etc/energybridge/service.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHON_DOTENV_DISABLED=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/bin/bash /opt/energybridge/deploy/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/energybridge

[Install]
WantedBy=multi-user.target
