# Replace the domain; no trailing slash. Public human collection requires HTTPS.
EB_PUBLIC_ORIGIN=https://survey.example.org
EB_HUMAN_PILOT=1
# Remains disabled until an operator explicitly changes this to 1.
EB_PLANNING_ENABLED=0
EB_DATA_DIR=/var/lib/energybridge/jobs
EPLUS_ROOT=/opt/EnergyPlus-24-1-0
EB_PILOT_ENV_FILE=/etc/energybridge/model.env
EB_RESOURCE_DIR=/var/lib/energybridge/limits
EB_EP_SLOTS=1
EB_API_SLOTS=1
EB_WORKERS=2
EB_JOB_TIMEOUT=300
EB_MAX_PENDING=100
EB_MAX_SESSION_JOBS=3
EB_MAX_DAILY_JOBS=250
# Waiting to START, separate from the execution timeout above.
EB_MAX_QUEUE_WAIT=120
# Unmeasured cold-start estimate; replaced by recent same-mode paired timings.
EB_ESTIMATED_JOB_SECONDS=60
# Optional: trusted HTTPS reverse-proxy login name, never a password.
# Enable Basic Auth and overwrite X-EB-Authenticated-User before configuring it.
EB_ADMIN_USER=
